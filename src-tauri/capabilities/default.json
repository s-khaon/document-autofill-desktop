{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "python-script",
          "cmd": "python3",
          "args": true,
          "sidecar": false
        },
        {
          "name": "venv-python",
          "cmd": "/Users/kang.song/projects/own/document-autofill-desktop/python/.venv/bin/python3",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "shell:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-appdata-write",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read",
    "fs:allow-appdata-read-recursive",
    "fs:allow-mkdir"
  ]
}
